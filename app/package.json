{
  "name": "agentic-army-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop harness for agentic-army: sessions, flows on a canvas, claude, codex and Jev.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "e2e": "npm run build && node --test e2e/*.test.ts",
    "dist": "npm run build && electron-builder --mac dir",
    "live:chat": "node e2e/live/chat.ts",
    "live:flow": "node e2e/live/flow.ts",
    "live:jev": "node e2e/live/jev.ts"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "build": {
    "appId": "dev.agentic-army.desktop",
    "productName": "Agentic Army",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    }
  }
}
